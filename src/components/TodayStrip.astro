---
// From Concept C: one slim row of live-status links directly under the hero.
// Opening hours are QNL's published hours; the open/closed state is worked out in the
// visitor's browser in Doha time (the page is prerendered). Without JS the weekly hours show.
import { t, formatDate, type Lang } from '../i18n';
import { records } from '../search/data';
import { itemHref } from '../search/links';
import { HOURS, STUDY_SPACES } from '../lib/visit';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const now = Date.now();
const next = records
  .filter((r) => r.type === 'event' && r.start && new Date(r.start).getTime() > now)
  .sort((a, b) => a.start!.localeCompare(b.start!))[0];
const nextWhen = next
  ? `${formatDate(lang, new Date(next.start!), { weekday: 'short' })} ${formatDate(lang, new Date(next.start!), { hour: '2-digit', minute: '2-digit', hour12: false })}`
  : '';
const nextTitle = next ? next.title[lang].replace(/\s*\((sample|نموذج)\)\s*$/, '') : '';
const sample = t(lang, 'label.sample');

// "HH:MM" in Doha time, in the page's numerals.
const hm = (h: number, m = 0) =>
  formatDate(lang, new Date(Date.UTC(2026, 0, 1, h - 3, m)), { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Qatar' });
// Each range is wrapped in a left-to-right isolate so "08:00–20:00" keeps its order in Arabic.
const range = (a: number, b: number) => `\u2066${hm(a)}–${hm(b)}\u2069`;
const week = t(lang, 'today.week')
  .replace('{wd}', range(HOURS.weekday.open, HOURS.weekday.close))
  .replace('{fr}', range(HOURS.friday.open, HOURS.friday.close));
const times = JSON.stringify({
  wd: [hm(HOURS.weekday.open), hm(HOURS.weekday.close)],
  fr: [hm(HOURS.friday.open), hm(HOURS.friday.close)],
});
const studyHref = itemHref(lang, { id: 'sv-study' });
---
<nav class="today" aria-label={t(lang, 'today.label')}>
  <div class="wrap">
    <ul role="list">
      <li>
        <a href={itemHref(lang, { id: 'sv-hours' })} data-hours data-times={times}
           data-open={t(lang, 'today.openNow')} data-closed={t(lang, 'today.closedNow')}
           data-until={t(lang, 'today.until')} data-today={t(lang, 'today.opensToday')} data-tomorrow={t(lang, 'today.opensTomorrow')}>
          <span class="k"><span class="dot" aria-hidden="true"></span><span data-k>{t(lang, 'today.hours')}</span></span>
          <span class="v" data-v>{week}</span>
          <span class="sub" data-sub hidden>{week}</span>
        </a>
      </li>
      <li class="study">
        <details data-study>
          <summary>
            <span class="k">{t(lang, 'today.study')}</span>
            <span class="v">{t(lang, 'today.studyValue')} <span class="chev" aria-hidden="true"></span></span>
          </summary>
          <div class="panel">
            <ul role="list" class="spaces">
              {STUDY_SPACES.map((s) => (
                <li>
                  <div class="sp">
                    <span class="sp-name">{s.name[lang]}</span>
                    <span class="sp-meta">{s.meta[lang]}</span>
                    <span class="sp-kit">{s.kit[lang]}</span>
                  </div>
                  <a class="sp-book" href={studyHref} aria-label={`${t(lang, 'today.studyBook')}: ${s.name[lang]}`}>{t(lang, 'today.studyBook')}</a>
                </li>
              ))}
            </ul>
            <p class="note">{t(lang, 'today.studyNote')}</p>
            <a class="all link" href={studyHref}>{t(lang, 'today.studyAll')} <span class="icon-dir" aria-hidden="true">→</span></a>
          </div>
        </details>
      </li>
      {next && (
        <li>
          <a href={itemHref(lang, next)}>
            <span class="k">{t(lang, 'today.next')}</span>
            <span class="v"><bdi>{nextTitle}</bdi> · <span class="when">{nextWhen}</span><span class="sample-tag">{sample}</span></span>
          </a>
        </li>
      )}
      <li>
        <a href={itemHref(lang, { id: 'sv-metro' })}>
          <span class="k">{t(lang, 'today.metro')}</span>
          <span class="v">{t(lang, 'today.metroValue')}</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  import { HOURS } from '../lib/visit';
  // Open or closed now, in Doha time (UTC+3 all year: Qatar has no daylight saving).
  document.querySelectorAll<HTMLElement>('[data-hours]').forEach((el) => {
    const d = el.dataset;
    const times = JSON.parse(d.times!) as { wd: [string, string]; fr: [string, string] };
    const day = (dow: number) => (dow === 5 ? { h: HOURS.friday, s: times.fr } : { h: HOURS.weekday, s: times.wd });
    const render = () => {
      const q = new Date(Date.now() + 3 * 3600e3);
      const dow = q.getUTCDay();
      const mins = q.getUTCHours() * 60 + q.getUTCMinutes();
      const today = day(dow);
      const open = mins >= today.h.open * 60 && mins < today.h.close * 60;
      let v: string;
      if (open) v = d.until!.replace('{t}', today.s[1]);
      else if (mins < today.h.open * 60) v = d.today!.replace('{t}', today.s[0]);
      else v = d.tomorrow!.replace('{t}', day((dow + 1) % 7).s[0]);
      el.querySelector('[data-k]')!.textContent = open ? d.open! : d.closed!;
      el.querySelector('[data-v]')!.textContent = v;
      el.querySelector<HTMLElement>('[data-sub]')!.hidden = false;
      el.classList.toggle('is-closed', !open);
    };
    render();
    setInterval(render, 60_000);
  });

  // Study spaces dropdown: close on Escape or a click elsewhere.
  document.querySelectorAll<HTMLDetailsElement>('[data-study]').forEach((det) => {
    document.addEventListener('click', (e) => { if (det.open && !det.contains(e.target as Node)) det.open = false; });
    det.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && det.open) { det.open = false; det.querySelector('summary')!.focus(); }
    });
  });
</script>

<style>
  .today { position: relative; z-index: 5; background: var(--color-paper); color: var(--color-ink); border-block-end: var(--hairline); font-size: var(--fs-sm); }
  ul { list-style: none; margin: 0; padding: 0; }
  .today .wrap > ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .today .wrap > ul > li + li { border-inline-start: var(--hairline); }
  a, summary {
    display: grid; align-content: start; gap: 0.2rem;
    block-size: 100%; padding: var(--s-2) var(--s-3); text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out-expo);
  }
  .today .wrap > ul > li:first-child > a { padding-inline-start: 0; }
  a:hover, summary:hover { background: var(--color-paper-2); }
  a:hover .v, summary:hover .v { text-decoration: underline; text-underline-offset: 0.25em; text-decoration-thickness: 1px; }
  a:focus-visible, summary:focus-visible { outline-offset: -2px; }
  .k { color: var(--color-grey-600); font-size: var(--fs-xs); display: flex; align-items: center; gap: 0.5rem; }
  .v { color: var(--color-ink); font-weight: 500; overflow-wrap: anywhere; }
  .sub { color: var(--color-grey-600); font-size: var(--fs-xs); }
  .sub[hidden] { display: none; }
  .when { font-variant-numeric: tabular-nums; }
  .dot { inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background: var(--color-status-open); flex: none; }
  .is-closed .dot { background: var(--color-grey-600); }
  .sample-tag { color: var(--color-grey-600); }

  /* Study spaces dropdown */
  .study { position: relative; }
  details { block-size: 100%; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .chev {
    display: inline-block; inline-size: 0.45em; block-size: 0.45em; margin-inline-start: 0.3em;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; /* physical: always points down */
    transform: translateY(-0.2em) rotate(45deg); transition: transform var(--dur-1);
  }
  details[open] .chev { transform: translateY(0.05em) rotate(-135deg); }
  details[open] summary { background: var(--color-paper-2); }
  .panel {
    position: absolute; inset-block-start: 100%; inset-inline-start: 0; z-index: 10;
    inline-size: min(26rem, calc(100vw - 2rem)); padding: var(--s-2) var(--s-3) var(--s-3);
    background: var(--color-paper); border: 1px solid var(--color-grey-100); border-radius: var(--radius-2);
    box-shadow: 0 12px 32px -12px rgb(9 9 9 / 0.3);
  }
  .spaces { display: grid; }
  .spaces li { display: flex; justify-content: space-between; align-items: center; gap: var(--s-2); padding-block: 0.7rem; }
  .spaces li + li { border-block-start: var(--hairline); }
  .sp { display: grid; gap: 0.1rem; min-inline-size: 0; }
  .sp-name { font-weight: 500; }
  .sp-meta { color: var(--color-grey-800); font-size: var(--fs-xs); font-variant-numeric: tabular-nums; }
  .sp-kit { color: var(--color-grey-600); font-size: var(--fs-xs); }
  .panel a { display: inline-flex; padding: 0; block-size: auto; }
  .sp-book {
    flex: none; align-items: center; min-block-size: 2.5rem; padding-inline: 0.9rem !important;
    border: 1px solid var(--color-ink); border-radius: var(--radius-2); font-weight: 500;
  }
  .sp-book:hover { background: var(--color-ink); color: var(--color-paper); }
  .note { margin: var(--s-1) 0 var(--s-2); color: var(--color-grey-600); font-size: var(--fs-xs); }
  .panel .all:hover { background: none; }
  .all { gap: 0.4em; align-items: center; min-block-size: 2.5rem; font-weight: 500; }

  @media (max-width: 56rem) {
    .today .wrap > ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .today .wrap > ul > li + li:nth-child(odd) { border-inline-start: 0; }
    .today .wrap > ul > li:nth-child(n + 3) { border-block-start: var(--hairline); }
    .today .wrap > ul > li:nth-child(odd) > a, .today .wrap > ul > li:nth-child(odd) summary { padding-inline-start: 0; }
    /* On narrow screens the panel spans the strip, not the cell. */
    .study { position: static; }
    .today .wrap { position: relative; }
    .panel { inset-inline: var(--gutter); inline-size: auto; }
  }
</style>
