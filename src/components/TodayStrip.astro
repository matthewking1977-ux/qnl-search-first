---
// From Concept C: one slim row of live-status links directly under the hero.
// Every value is a placeholder ([TBC] / [live] / SAMPLE) until wired to QNL systems.
import { t, formatDate, type Lang } from '../i18n';
import { records } from '../search/data';
import { itemHref } from '../search/links';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const now = Date.now();
const next = records
  .filter((r) => r.type === 'event' && r.start && new Date(r.start).getTime() > now)
  .sort((a, b) => a.start!.localeCompare(b.start!))[0];
const nextWhen = next
  ? `${formatDate(lang, new Date(next.start!), { weekday: 'short' })} ${formatDate(lang, new Date(next.start!), { hour: '2-digit', minute: '2-digit', hour12: false })}`
  : '';
const nextTitle = next ? next.title[lang].replace(/\s*\((sample|نموذج)\)\s*$/, '') : '';
const sample = t(lang, 'label.sample');
---
<nav class="today" aria-label={t(lang, 'today.label')}>
  <div class="wrap">
    <ul role="list">
      <li>
        <a href={itemHref(lang, { id: 'sv-hours' })}>
          <span class="k"><span class="dot" aria-hidden="true"></span>{t(lang, 'today.open')}</span>
          <span class="v">{t(lang, 'today.openValue')}</span>
        </a>
      </li>
      <li>
        <a href={itemHref(lang, { id: 'sv-study' })}>
          <span class="k">{t(lang, 'today.study')}</span>
          <span class="v">{t(lang, 'today.studyValue')}</span>
        </a>
      </li>
      {next && (
        <li>
          <a href={itemHref(lang, next)}>
            <span class="k">{t(lang, 'today.next')}</span>
            <span class="v"><bdi>{nextTitle}</bdi> · <span class="when">{nextWhen}</span><span class="sample-tag">{sample}</span></span>
          </a>
        </li>
      )}
      <li>
        <a href={itemHref(lang, { id: 'sv-metro' })}>
          <span class="k">{t(lang, 'today.metro')}</span>
          <span class="v">{t(lang, 'today.metroValue')}</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .today { background: var(--color-paper); color: var(--color-ink); border-block-end: var(--hairline); font-size: var(--fs-sm); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  li + li { border-inline-start: var(--hairline); }
  a {
    display: grid; align-content: start; gap: 0.2rem;
    block-size: 100%; padding: var(--s-2) var(--s-3); text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out-expo);
  }
  li:first-child a { padding-inline-start: 0; }
  a:hover { background: var(--color-paper-2); }
  a:hover .v { text-decoration: underline; text-underline-offset: 0.25em; text-decoration-thickness: 1px; }
  a:focus-visible { outline-offset: -2px; }
  .k { color: var(--color-grey-600); font-size: var(--fs-xs); display: flex; align-items: center; gap: 0.5rem; }
  .v { color: var(--color-ink); font-weight: 500; overflow-wrap: anywhere; }
  .when { font-variant-numeric: tabular-nums; }
  .dot { inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background: var(--color-status-open); flex: none; }
  .sample-tag { color: var(--color-grey-600); }

  @media (max-width: 56rem) {
    ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    li + li:nth-child(odd) { border-inline-start: 0; }
    li:nth-child(n + 3) { border-block-start: var(--hairline); }
    li:nth-child(odd) a { padding-inline-start: 0; }
  }
</style>
