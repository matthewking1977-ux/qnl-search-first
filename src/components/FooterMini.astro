---
// Minimal footer for utility pages (styleguide). The full homepage footer is built in Phase 5.
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<footer class="mini on-dark">
  <div class="wrap row">
    <span>{t(lang, 'meta.title')}</span>
    <span class="credit" lang="en" dir="ltr">{t(lang, 'footer.credit')} · QNL-RFQ-90</span>
  </div>
</footer>
<style>
  .mini { background: var(--color-ink); color: var(--color-grey-300); font-size: var(--fs-xs); }
  .row { display: flex; justify-content: space-between; gap: var(--s-2); padding-block: var(--s-3); flex-wrap: wrap; }
  [lang='ar'] .credit { font-family: var(--font-sans); }
</style>
