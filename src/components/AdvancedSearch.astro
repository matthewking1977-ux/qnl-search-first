---
// Advanced search: a plain GET form to /search (works without JavaScript; the
// results page turns it into one canonical URL). The script adds/removes lines,
// pre-fills from an earlier search and keeps a live count of matches.
import Header from './Header.astro';
import Footer from './Footer.astro';
import { t, fmt, localPath, type Lang } from '../i18n';
import { catalogueRef, formatGroupLabel, locationLabel, languageLabel, collectionLabel } from '../search/catalogue';
import { ADV_ROWS, ADV_FIELDS } from '../search/advanced';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const action = localPath(lang, '/search');
const groups = Object.entries(catalogueRef.formatGroups).sort((a, b) => a[1].order - b[1].order).map(([k]) => k);
const qnlLocations = Object.entries(catalogueRef.locations).filter(([, v]) => v.qnl).map(([k]) => k);
const languages = ['ara', 'eng', 'fre', 'mul'];
const collections = Object.keys(catalogueRef.collections);
const scopes = ['', 'books', 'heritage', 'research', 'events', 'services'] as const;
const counts = {
  zero: t(lang, 'search.count0'), one: t(lang, 'search.count1'), two: t(lang, 'search.count2'),
  few: t(lang, 'search.countFew'), other: t(lang, 'search.count'),
};
---
<Header lang={lang} tone="light" />
<main id="main" class="wrap adv" tabindex="-1">
  <h1 class="t-h2">{t(lang, 'adv.title')}</h1>
  <p class="t-lead prose-measure lead">{t(lang, 'adv.lead')}</p>

  <form id="adv-form" class="adv-form" action={action} method="get" novalidate
    data-lang={lang} data-base={action} data-counts={JSON.stringify(counts)}
    data-counting={t(lang, 'adv.counting')} data-empty={t(lang, 'adv.empty')}>

    <fieldset class="block">
      <legend class="t-h3">{t(lang, 'adv.rows')}</legend>
      <ol class="rows" role="list">
        {Array.from({ length: ADV_ROWS }, (_, k) => k + 1).map((n) => (
          <li class="row" data-row={n} hidden={n > 3} aria-label={fmt(t(lang, 'adv.line'), { n })}>
            <div class="cell op">
              {n > 1 ? (
                <>
                  <label class="sr-only" for={`o${n}`}>{t(lang, 'adv.op')}</label>
                  <select id={`o${n}`} name={`o${n}`}>
                    {(['AND', 'OR', 'NOT'] as const).map((o) => <option value={o}>{t(lang, `adv.op.${o}` as any)}</option>)}
                  </select>
                </>
              ) : <span class="first" aria-hidden="true"></span>}
            </div>
            <div class="cell field">
              <label class="sr-only" for={`f${n}`}>{t(lang, 'adv.field')}</label>
              <select id={`f${n}`} name={`f${n}`}>
                {ADV_FIELDS.map((f) => <option value={f}>{t(lang, `q.field.${f}` as any)}</option>)}
              </select>
            </div>
            <div class="cell text">
              <label class="sr-only" for={`t${n}`}>{t(lang, 'adv.text')}</label>
              <input class="input" id={`t${n}`} name={`t${n}`} type="text" autocomplete="off" spellcheck="false" />
            </div>
            <div class="cell rm">
              {n > 1 && (
                <button type="button" class="rm-btn" data-remove={n} aria-label={fmt(t(lang, 'adv.removeRow'), { n })} hidden>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 6l8 8M14 6l-8 8" /></svg>
                </button>
              )}
            </div>
          </li>
        ))}
      </ol>
      <div class="rows-foot">
        <button type="button" class="btn btn--ghost add" data-add hidden>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>{t(lang, 'adv.addRow')}
        </button>
        <p class="tip">{t(lang, 'adv.tip')}</p>
      </div>
    </fieldset>

    <fieldset class="block">
      <legend class="t-h3">{t(lang, 'adv.limits')}</legend>
      <p class="note">{t(lang, 'adv.catNote')}</p>
      <div class="limits">
        <fieldset class="group group--wide">
          <legend>{t(lang, 'adv.f.format')}</legend>
          <div class="opts opts--2">
            {groups.map((g) => <label class="opt-line"><input type="checkbox" name="fmt" value={g} /><span>{formatGroupLabel(g, lang)}</span></label>)}
          </div>
        </fieldset>
        <fieldset class="group">
          <legend>{t(lang, 'adv.f.location')}</legend>
          <div class="opts">
            {qnlLocations.map((l) => <label class="opt-line"><input type="checkbox" name="loc" value={l} /><span>{locationLabel(l, lang)}</span></label>)}
            <label class="opt-line"><input type="checkbox" name="loc" value="partner" /><span>{t(lang, 'adv.partner')}</span></label>
          </div>
        </fieldset>
        <div class="stack">
          <fieldset class="group">
            <legend>{t(lang, 'adv.f.clang')}</legend>
            <div class="opts">
              {languages.map((c) => <label class="opt-line"><input type="checkbox" name="cl" value={c} /><span>{languageLabel(c, lang)}</span></label>)}
            </div>
          </fieldset>
          <fieldset class="group">
            <legend>{t(lang, 'adv.availability')}</legend>
            <div class="opts">
              {(['avail', 'online', 'atqnl'] as const).map((k) => <label class="opt-line"><input type="checkbox" name={k} value="1" /><span>{t(lang, `adv.flag.${k}` as any)}</span></label>)}
            </div>
          </fieldset>
        </div>
        <fieldset class="group">
          <legend>{t(lang, 'adv.f.collection')}</legend>
          <div class="opts">
            {collections.map((c) => <label class="opt-line"><input type="checkbox" name="col" value={c} /><span>{collectionLabel(c, lang)}</span></label>)}
          </div>
        </fieldset>
        <fieldset class="group years">
          <legend>{t(lang, 'adv.years')}</legend>
          <div class="year-row" dir="ltr">
            <label><span>{t(lang, 'adv.from')}</span><input class="input" name="yf" id="yf" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="1900" /></label>
            <span aria-hidden="true">–</span>
            <label><span>{t(lang, 'adv.to')}</span><input class="input" name="yt" id="yt" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="2026" /></label>
          </div>
        </fieldset>
      </div>
    </fieldset>

    <fieldset class="block">
      <legend class="t-h3">{t(lang, 'adv.scope')}</legend>
      <div class="scopes">
        {scopes.map((sc) => (
          <label class="scope"><input type="radio" name="type" value={sc} checked={sc === ''} /><span>{sc ? t(lang, `group.${sc}` as any) : t(lang, 'filter.all')}</span></label>
        ))}
      </div>
    </fieldset>

    <div class="bar">
      <p class="count" role="status" aria-live="polite" aria-atomic="true" data-count>{t(lang, 'adv.countIdle')}</p>
      <div class="bar-actions">
        <button type="reset" class="btn btn--ghost">{t(lang, 'adv.clear')}</button>
        <button type="submit" class="btn btn--primary">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13Zm4.7-1.8L20 20" /></svg>
          {t(lang, 'adv.submit')}
        </button>
      </div>
    </div>
  </form>
</main>
<Footer lang={lang} />

<script>
  import { queryToRows, rowsToQuery, readCatalogueFilters, canonicalFromAdvanced, ADV_ROWS } from '../search/advanced';
  import type { Group } from '../search/types';

  const form = document.getElementById('adv-form') as HTMLFormElement | null;
  if (form) {
    const lang = form.dataset.lang as 'en' | 'ar';
    const base = form.dataset.base!;
    const counts = JSON.parse(form.dataset.counts!);
    const countEl = form.querySelector<HTMLElement>('[data-count]')!;
    const addBtn = form.querySelector<HTMLButtonElement>('[data-add]')!;
    const rows = [...form.querySelectorAll<HTMLElement>('.row')];
    const el = <T extends HTMLElement>(name: string) => form.elements.namedItem(name) as T | null;

    const visible = () => rows.filter((r) => !r.hidden).length;
    const syncButtons = () => {
      addBtn.hidden = visible() >= ADV_ROWS;
      rows.forEach((r, i) => { const b = r.querySelector<HTMLButtonElement>('[data-remove]'); if (b) b.hidden = i === 0 || visible() <= 1; });
    };
    addBtn.addEventListener('click', () => {
      const next = rows.find((r) => r.hidden);
      if (!next) return;
      next.hidden = false;
      syncButtons();
      next.querySelector<HTMLInputElement>('input')?.focus();
    });
    form.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-remove]');
      if (!b) return;
      const n = +b.dataset.remove!;
      const row = rows[n - 1];
      // Shift later lines up so there are no gaps, then hide the last visible one.
      const vis = rows.filter((r) => !r.hidden);
      const idx = vis.indexOf(row);
      const num = (r: HTMLElement) => +r.dataset.row!;
      const copy = (to: number, from: number | null) => {
        for (const k of ['t', 'f', 'o']) {
          const a = el<HTMLInputElement | HTMLSelectElement>(`${k}${to}`);
          if (!a) continue;
          const b = from ? el<HTMLInputElement | HTMLSelectElement>(`${k}${from}`) : null;
          a.value = b ? b.value : a.tagName === 'SELECT' ? (a as HTMLSelectElement).options[0].value : '';
        }
      };
      for (let i = idx; i < vis.length - 1; i++) copy(num(vis[i]), num(vis[i + 1]));
      const last = vis[vis.length - 1];
      copy(num(last), null);
      last.hidden = true;
      syncButtons();
      (vis[Math.max(0, idx - 1)].querySelector('input') as HTMLInputElement | null)?.focus();
      schedule();
    });

    // Pre-fill from ?q=… (and filters) when arriving via "Edit advanced search".
    const p = new URLSearchParams(location.search);
    const q = p.get('q');
    if (q) {
      const { rows: rr, yf, yt } = queryToRows(q);
      rr.forEach((r, i) => {
        rows[i].hidden = false;
        el<HTMLInputElement>(`t${i + 1}`)!.value = r.text;
        el<HTMLSelectElement>(`f${i + 1}`)!.value = r.field;
        const o = el<HTMLSelectElement>(`o${i + 1}`);
        if (o) o.value = r.op;
      });
      if (yf) el<HTMLInputElement>('yf')!.value = String(yf);
      if (yt) el<HTMLInputElement>('yt')!.value = String(yt);
    }
    for (const name of ['fmt', 'loc', 'cl', 'col']) {
      const vals = p.getAll(name);
      form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach((x) => (x.checked = vals.includes(x.value)));
    }
    for (const name of ['avail', 'online', 'atqnl']) { const x = form.querySelector<HTMLInputElement>(`input[name="${name}"]`); if (x) x.checked = p.get(name) === '1'; }
    const type = p.get('type');
    if (type) { const r = form.querySelector<HTMLInputElement>(`input[name="type"][value="${CSS.escape(type)}"]`); if (r) r.checked = true; }
    syncButtons();

    // Live count. The search index loads on first change (it's the same lazy chunk
    // the search box uses), so the page itself stays light.
    let provider: import('../search/LocalIndexAdapter').LocalIndexAdapter | null = null;
    let timer = 0, seq = 0;
    const plural = new Intl.PluralRules(lang);
    const label = (n: number) => {
      if (n === 0) return counts.zero;
      if (n === 1) return counts.one;
      const c = plural.select(n);
      return (c === 'two' ? counts.two : c === 'few' ? counts.few : counts.other).replace('{n}', String(n));
    };
    const params = () => new URLSearchParams(new FormData(form) as any);
    const update = async () => {
      const my = ++seq;
      const ps = params();
      const qq = rowsToQuery(ps) ?? '';
      const filters = readCatalogueFilters(ps);
      if (!qq && !Object.keys(filters).length) { countEl.textContent = form.dataset.empty!; return; }
      countEl.textContent = form.dataset.counting!;
      if (!provider) { const m = await import('../search/LocalIndexAdapter'); provider = new m.LocalIndexAdapter(); }
      const group = (ps.get('type') || 'all') as Group | 'all';
      const res = await provider.search({ q: qq, lang, filters: { group, ...filters }, limit: 1 });
      if (my === seq) countEl.textContent = label(res.total);
    };
    const schedule = () => { clearTimeout(timer); timer = window.setTimeout(update, 250); };
    form.addEventListener('input', schedule);
    form.addEventListener('change', schedule);
    form.addEventListener('reset', () => setTimeout(() => {
      rows.forEach((r, i) => (r.hidden = i >= 3));
      syncButtons();
      countEl.textContent = form.dataset.empty!;
    }));
    if (q || [...p.keys()].length) schedule();

    // Submit straight to the canonical results URL (skips the server redirect).
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const ps = params();
      if (!rowsToQuery(ps) && !Object.keys(readCatalogueFilters(ps)).length) {
        countEl.textContent = form.dataset.empty!;
        el<HTMLInputElement>('t1')?.focus();
        return;
      }
      location.href = canonicalFromAdvanced(base, ps);
    });
  }
</script>

<style>
  .adv { padding-block: var(--s-6) var(--s-12); max-inline-size: 64rem; }
  .adv h1 { margin: 0; }
  .lead { margin: var(--s-2) 0 var(--s-4); }
  .adv-form { display: grid; gap: var(--s-4); }
  .block { border: 0; margin: 0; padding: var(--s-4) 0 0; border-block-start: var(--hairline); min-inline-size: 0; }
  .block > legend { padding: 0; margin-block-end: var(--s-2); float: inline-start; inline-size: 100%; }
  .block > legend + * { clear: both; }

  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-1); }
  .row { display: grid; grid-template-columns: 10rem 10rem minmax(0, 1fr) 2.75rem; gap: var(--s-1); align-items: center; }
  .row[hidden] { display: none; }
  .row select, .row .input { inline-size: 100%; min-block-size: 3rem; }
  select {
    font: inherit; font-size: var(--fs-sm); color: var(--color-ink); background: var(--color-paper);
    border: 1px solid var(--color-grey-600); border-radius: var(--radius-2); padding-inline: 0.75rem;
  }
  select:hover { border-color: var(--color-ink); }
  .rm-btn { display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; border: 0; background: none; border-radius: var(--radius-1); color: var(--color-grey-800); cursor: pointer; }
  .rm-btn:hover { background: var(--color-paper-2); color: var(--color-ink); }
  .rm-btn svg, .add svg, .bar svg { inline-size: 1.1rem; block-size: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }
  .rows-foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-3); margin-block-start: var(--s-2); }
  .tip, .note { margin: 0; color: var(--color-grey-600); font-size: var(--fs-sm); }
  .note { margin-block-end: var(--s-2); }

  .limits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3) var(--s-4); }
  .group { border: 0; margin: 0; padding: 0; min-inline-size: 0; }
  .group legend { font-weight: 500; font-size: var(--fs-sm); padding: 0; margin-block-end: 0.5rem; }
  .group--wide { grid-column: span 2; }
  .stack { display: grid; gap: var(--s-3); align-content: start; }
  .opts { display: grid; gap: 0.125rem; }
  .opts--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-3); }
  .opt-line { display: flex; align-items: center; gap: 0.6rem; min-block-size: 2.5rem; font-size: var(--fs-sm); cursor: pointer; }
  .opt-line input, .scope input { inline-size: 1.15rem; block-size: 1.15rem; accent-color: var(--color-accent); flex: none; }
  .years { align-self: start; }
  .year-row { display: flex; align-items: end; gap: 0.5rem; }
  :global([dir='rtl']) .year-row { flex-direction: row-reverse; justify-content: flex-end; }
  .year-row label { display: grid; gap: 0.25rem; font-size: var(--fs-xs); color: var(--color-grey-600); }
  .year-row .input { inline-size: 6rem; min-block-size: 3rem; font-variant-numeric: tabular-nums; }
  .year-row > span { padding-block-end: 0.75rem; }

  .scopes { display: flex; flex-wrap: wrap; gap: 0.5rem var(--s-3); }
  .scope { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 2.75rem; font-size: var(--fs-sm); cursor: pointer; }

  /* Sticky action bar: the count and Search stay in reach while scrolling. */
  .bar {
    position: sticky; inset-block-end: 0; z-index: 5;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2);
    padding: var(--s-2) 0; background: var(--color-paper); border-block-start: 1px solid var(--color-grey-300);
  }
  .bar .count { margin: 0; font-size: var(--fs-sm); color: var(--color-grey-800); font-weight: 500; }
  .bar-actions { display: flex; gap: var(--s-1); }
  .bar .btn--primary { min-block-size: 3rem; padding-inline: 1.5rem; }

  @media (max-width: 56rem) {
    .limits { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 2.75rem; padding-block: var(--s-1); border-block-end: var(--hairline); }
    .row .text { grid-column: 1 / 3; grid-row: 2; }
    .row .rm { grid-column: 3; grid-row: 1; }
    .row:first-child .op { display: none; }
    .row:first-child .field { grid-column: 1 / 3; }
    .limits { grid-template-columns: minmax(0, 1fr); }
    .group--wide { grid-column: auto; }
    .opts--2 { grid-template-columns: minmax(0, 1fr); }
    .bar { flex-direction: column; align-items: stretch; }
    .bar-actions { justify-content: space-between; }
    .bar .btn--primary { flex: 1; }
  }
</style>
