---
// One page per sample record, so every search result leads somewhere real.
import Header from './Header.astro';
import Footer from './Footer.astro';
import Picture from './Picture.astro';
import { t, fmt, formatDate, localPath, type Lang } from '../i18n';
import RecordActions from './RecordActions.astro';
import { primaryAction } from '../search/cite';
import { engineData } from '../search/data';
import type { LibraryRecord } from '../search/types';
import { searchHref } from '../search/links';
import {
  authorLine, publicationLine, formatLabel, languageLabel, collectionLabel, locationLabel,
  statusLabel, placeLabel, isQnlLocation, catalogueRef,
} from '../search/catalogue';

interface Props { lang: Lang; record: LibraryRecord; }
const { lang, record: r } = Astro.props;
const tagLabel = (k: string) => engineData.tags[k]?.[lang];
const c = r.catalogue;
const typeLabel = c ? formatLabel(c.format, lang) : t(lang, `item.type.${r.type}` as any);
const listSep = lang === 'ar' ? '، ' : ', ';
const act = c ? primaryAction(r) : null;
const day = (iso: string) => formatDate(lang, new Date(iso + 'T12:00:00'), { day: 'numeric', month: 'short', year: 'numeric' });
// Variant spellings that differ from the preferred place labels (shows the merge at work).
const preferred = new Set((c?.places ?? []).flatMap((k) => [catalogueRef.places[k]?.en, catalogueRef.places[k]?.ar]));
const variants = (c?.placesAsCatalogued ?? []).filter((v) => !preferred.has(v));
---
<Header lang={lang} tone="light" />
<main id="main" class="wrap item" tabindex="-1">
  <p><a class="link" href={searchHref(lang, '')}><span class="arrow icon-dir" aria-hidden="true">←</span> {t(lang, 'item.back')}</a></p>
  <article class="grid">
    <div class="body">
      <p class="t-eyebrow">{typeLabel} <span class="sample-tag">{t(lang, 'label.sample')}</span></p>
      <h1 class="t-h2">{r.title[lang]}</h1>
      <p class="t-lead prose-measure">{r.summary[lang]}</p>
      {c && <div class="item-actions"><RecordActions lang={lang} record={r} onItemPage /></div>}
      {act && (act.kind === 'hold' || act.kind === 'partner') && (
        <section id="hold" class="getit" aria-labelledby="hold-h" tabindex="-1">
          <h2 id="hold-h" class="t-ui getit-h">{t(lang, 'hold.title')}</h2>
          <p>{t(lang, act.kind === 'partner' ? 'hold.partner' : 'hold.body')}</p>
          <p><a class="btn btn--primary btn--sm" href={localPath(lang, '/item/sv-renew')}>{t(lang, 'hold.signin')}</a> <span class="getit-note">{t(lang, 'sample.notConnected')}</span></p>
        </section>
      )}
      {act && act.kind === 'online' && (
        <section id="access" class="getit" aria-labelledby="access-h" tabindex="-1">
          <h2 id="access-h" class="t-ui getit-h">{t(lang, 'access.title')}</h2>
          <p>{t(lang, 'access.body')}</p>
          <p><a class="btn btn--primary btn--sm" href={localPath(lang, '/item/sv-renew')}>{t(lang, 'access.signin')}</a> <span class="getit-note">{t(lang, 'sample.notConnected')}</span></p>
        </section>
      )}
      {r.task && (
        <div class="answer">
          <p>{r.task.answer[lang]}</p>
          <a class="btn btn--primary" href="#main">{r.task.action[lang]} <span class="arrow icon-dir" aria-hidden="true">→</span></a>
        </div>
      )}
      {c ? (
        <>
          <dl class="facts">
            <dt>{t(lang, 'item.c.author')}</dt><dd>{authorLine(c, lang)}</dd>
            {c.publication && (<><dt>{t(lang, 'item.c.published')}</dt><dd>{publicationLine(c, lang)}</dd></>)}
            {c.edition && (<><dt>{t(lang, 'item.c.edition')}</dt><dd>{c.edition[lang]}</dd></>)}
            <dt>{t(lang, 'item.c.format')}</dt><dd>{formatLabel(c.format, lang)}</dd>
            <dt>{t(lang, 'item.c.description')}</dt><dd>{c.description[lang]}</dd>
            <dt>{t(lang, 'item.c.language')}</dt><dd>{languageLabel(c.language, lang)}</dd>
            <dt>{t(lang, 'item.c.subjects')}</dt>
            <dd><ul class="subjects">{c.subjects.map((sub) => <li><a class="link" href={searchHref(lang, sub[lang].split(' — ')[0])}>{sub[lang]}</a></li>)}</ul></dd>
            {c.places?.length ? (<><dt>{t(lang, 'item.c.places')}</dt><dd>
              {c.places.map((k) => placeLabel(k, lang)).join(listSep)}
              {variants.length > 0 && <span class="variants"> · {t(lang, 'item.c.asCatalogued')}: <bdi dir="ltr" lang="en">{variants.join(', ')}</bdi></span>}
            </dd></>) : null}
            {c.isbn && (<><dt>{t(lang, 'item.c.isbn')}</dt><dd><bdi dir="ltr" class="mono">{c.isbn}</bdi></dd></>)}
            <dt>{t(lang, 'item.c.collection')}</dt><dd>{collectionLabel(c.collection, lang)}</dd>
            <dt>{t(lang, 'results.audience')}</dt><dd>{r.audience.map((a) => t(lang, `aud.${a}` as any)).join(listSep)}</dd>
          </dl>
          <h2 class="t-h3 holdings-h" id="holdings" tabindex="-1">{t(lang, 'item.c.holdings')}</h2>
          <div class="table-wrap" role="region" aria-labelledby="holdings" tabindex="0">
            <table class="holdings">
              <thead><tr><th scope="col">{t(lang, 'item.c.location')}</th><th scope="col">{t(lang, 'item.c.callNo')}</th><th scope="col">{t(lang, 'item.c.status')}</th></tr></thead>
              <tbody>
                {c.holdings.map((h) => (
                  <tr>
                    <td>{locationLabel(h.location, lang)}{!isQnlLocation(h.location) && <span class="partner">{t(lang, 'item.c.partner')}</span>}</td>
                    <td>{h.callNo ? <bdi dir="ltr" class="mono">{h.callNo}</bdi> : '—'}</td>
                    <td>
                      <span class={`status status--${h.status}`}>{statusLabel(h.status, lang)}</span>
                      {h.status === 'on-loan' && h.due && <span class="sub">{fmt(t(lang, 'item.c.due'), { date: day(h.due) })}</span>}
                      {h.status === 'on-order' && h.ordered && <span class="sub">{fmt(t(lang, 'item.c.ordered'), { n: h.copies ?? 1, date: day(h.ordered) })}</span>}
                      {h.status === 'online' && <span class="sub">{t(lang, 'item.c.onlineNote')}</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : (
      <dl class="facts">
        {r.start && (<><dt>{t(lang, 'results.date')}</dt><dd>{formatDate(lang, new Date(r.start), { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false })}</dd></>)}
        {r.place && (<><dt>{lang === 'ar' ? 'المكان' : 'Place'}</dt><dd>{r.place[lang]}</dd></>)}
        {r.year && (<><dt>{lang === 'ar' ? 'سنة النشر' : 'Year'}</dt><dd>{r.year}</dd></>)}
        <dt>{t(lang, 'results.language')}</dt><dd>{t(lang, `meta.lang.${r.lang}` as any)}</dd>
        <dt>{t(lang, 'results.audience')}</dt><dd>{r.audience.map((a) => t(lang, `aud.${a}` as any)).join(listSep)}</dd>
      </dl>
      )}
      <h2 class="t-ui related">{t(lang, 'item.related')}</h2>
      <ul class="tags">
        {r.tags.filter(tagLabel).map((k) => <li><a class="chip" href={searchHref(lang, tagLabel(k)!)}>{tagLabel(k)}</a></li>)}
      </ul>
      <p class="note">{t(lang, 'item.sampleNote')}</p>
    </div>
    {r.image && (
      <div class="media">
        <Picture name={r.image as any} alt="" sizes="(min-width: 64rem) 40vw, 100vw" />
      </div>
    )}
  </article>
</main>
<Footer lang={lang} />
<style>
  .item { padding-block: var(--s-4) var(--s-12); }
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--s-6); margin-block-start: var(--s-4); }
  @media (min-width: 64rem) { .grid:has(.media) { grid-template-columns: 1.3fr 1fr; } }
  .body { display: grid; gap: var(--s-2); align-content: start; }
  .body h1, .body p { margin: 0; }
  .answer { padding: var(--s-3); background: var(--color-paper-2); border-inline-start: 3px solid var(--color-accent); display: grid; gap: var(--s-2); justify-items: start; }
  .answer p { margin: 0; max-inline-size: 62ch; }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem var(--s-3); margin: var(--s-2) 0 0; font-size: var(--fs-sm); }
  .facts dt { color: var(--color-grey-600); }
  .facts dd { margin: 0; }
  .item-actions { margin-block: var(--s-1); }
  .getit { padding: var(--s-2) var(--s-3); background: var(--color-paper-2); border-inline-start: 3px solid var(--color-accent); border-radius: var(--radius-2); display: grid; gap: var(--s-1); }
  .getit:target, .holdings-h:target { scroll-margin-block-start: var(--s-4); }
  .getit:focus { outline: none; }
  .getit-h { margin: 0; font-weight: 500; }
  .getit p { margin: 0; max-inline-size: 62ch; }
  .getit-note { font-size: var(--fs-xs); color: var(--color-grey-600); margin-inline-start: var(--s-1); }
  .subjects { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .variants { color: var(--color-grey-600); }
  .mono { font-family: var(--font-mono); font-size: 0.92em; }
  .holdings-h { margin: var(--s-4) 0 0; }
  .table-wrap { overflow-x: auto; }
  .table-wrap:focus-visible { outline-offset: 2px; }
  .holdings { inline-size: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
  .holdings th { text-align: start; font-weight: 500; color: var(--color-grey-600); padding-block: 0.5rem; padding-inline: 0 0.75rem; border-block-end: 1px solid var(--color-grey-300); }
  .holdings td { padding-block: 0.75rem; padding-inline: 0 0.75rem; border-block-end: var(--hairline); vertical-align: top; }
  .partner { display: block; color: var(--color-grey-600); font-size: var(--fs-xs); }
  .sub { display: block; color: var(--color-grey-600); font-size: var(--fs-xs); margin-block-start: 0.15rem; }
  .related { font-weight: 500; margin: var(--s-2) 0 0; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags .chip { text-decoration: none; }
  .note { color: var(--color-grey-600); font-size: var(--fs-sm); border-block-start: var(--hairline); padding-block-start: var(--s-2); }
  .media :global(.pic) { aspect-ratio: 4 / 5; }
</style>
