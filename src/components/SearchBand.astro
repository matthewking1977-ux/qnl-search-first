---
// Phase 2 stand-in for the hero: dark band with the hero line and the search box.
// Phase 3 replaces this with the full photo hero and the Today strip.
import Header from './Header.astro';
import SearchBar from './SearchBar.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<div class="band on-dark">
  <Header lang={lang} tone="dark" />
  <div class="wrap inner">
    <h1 class="t-display line">{t(lang, 'hero.line')}</h1>
    <SearchBar lang={lang} variant="hero" autoFocusDesktop />
  </div>
</div>
<style>
  .band { position: relative; background: var(--color-ink); color: var(--color-paper); }
  .inner { display: grid; justify-items: center; gap: var(--s-5); padding-block: calc(4.5rem + var(--s-12)) var(--s-12); text-align: center; }
  .line { margin: 0; max-inline-size: 16ch; }
</style>
