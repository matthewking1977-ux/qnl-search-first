---
import { formatLabel, languageLabel, formatGroupLabel, locationLabel, collectionLabel } from '../search/catalogue';
import { readCatalogueFilters, LIST_PARAMS, FLAG_PARAMS } from '../search/advanced';
import { serializeQuery, type Clause } from '../search/query';
// Server-rendered results page. Works fully without JavaScript:
// GET form for query, facets and sort; shareable URLs; numbered pages.
import Header from './Header.astro';
import Footer from './Footer.astro';
import SearchBar from './SearchBar.astro';
import { t, fmt, formatDate, type Lang } from '../i18n';
import { createEngine } from '../search/engine';
import { highlight } from '../search/highlight';
import { engineData } from '../search/data';
import { GROUP_ORDER, TYPE_TO_GROUP, type Group, type SortKey } from '../search/types';
import { itemHref, searchHref, catalogueHref } from '../search/links';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const engine = createEngine(engineData);

const p = Astro.url.searchParams;
const q = (p.get('q') ?? '').slice(0, 200);
const groupParam = p.get('type') as Group | null;
const group: Group | 'all' = groupParam && GROUP_ORDER.includes(groupParam) ? groupParam : 'all';
const AUD = ['adults', 'students', 'researchers', 'teens', 'children'];
const audience = p.getAll('aud').filter((a) => AUD.includes(a));
const language = p.getAll('lang').filter((l) => l === 'en' || l === 'ar') as ('en' | 'ar')[];
const dateP = p.get('date');
const date = dateP === 'week' || dateP === 'month' || dateP === 'later' ? dateP : undefined;
const sortP = p.get('sort') as SortKey | null;
const sort: SortKey = sortP === 'date' || sortP === 'title' ? sortP : 'relevance';
const PER = 10;
const page = Math.max(1, parseInt(p.get('page') ?? '1', 10) || 1);

const cat = readCatalogueFilters(p);
const browsing = !q && Object.keys(cat).length > 0;
const res = q || browsing ? engine.search({ q, lang, filters: { group, audience, language, date, ...cat }, sort }) : null;
const total = res?.total ?? 0;
const pages = Math.max(1, Math.ceil(total / PER));
const hits = res ? res.hits.slice((page - 1) * PER, page * PER) : [];

const qs = (over: Record<string, string | string[] | undefined>) => {
  const u = new URLSearchParams();
  const base: Record<string, string | string[] | undefined> = {
    q, type: group === 'all' ? undefined : group, aud: audience, lang: language, date, sort: sort === 'relevance' ? undefined : sort,
    fmt: cat.format, loc: cat.location, cl: cat.clang, col: cat.collection,
    avail: cat.avail ? '1' : undefined, online: cat.online ? '1' : undefined, atqnl: cat.atQnl ? '1' : undefined,
    ...over,
  };
  for (const [k, v] of Object.entries(base)) {
    if (v === undefined || v === '') continue;
    (Array.isArray(v) ? v : [v]).forEach((x) => u.append(k, x));
  }
  return `${searchHref(lang, '').split('?')[0]}?${u}`;
};

const Hl = (text: string, terms: string[]) => highlight(text, terms);

// Structured query → removable tags ("Title: old maps ×", "not film ×").
const clauses = res?.parsed?.clauses ?? [];
const clauseText = (c: Clause) => {
  const v = c.field === 'year' && (c.from || c.to)
    ? (c.from && c.from === c.to ? String(c.from) : `${c.from ?? '…'}–${c.to ?? '…'}`)
    : c.phrase ? (lang === 'ar' ? `«${c.text}»` : `“${c.text}”`) : c.text;
  const op = c.op === 'NOT' || (c.op === 'OR') ? t(lang, `q.op.${c.op}` as any) + ' ' : '';
  // Keep years and ISBNs left-to-right inside Arabic text (LRI … PDI).
  const val = (c.field === 'year' || c.field === 'isbn') && lang === 'ar' ? `\u2066${v}\u2069` : v;
  return `${op}${c.field === 'any' ? '' : t(lang, `q.field.${c.field}` as any) + ': '}${val}`;
};
const without = (i: number) => {
  const rest = clauses.filter((_, j) => j !== i).map((c, j) => (j === 0 && c.op === 'OR' ? { ...c, op: 'AND' as const } : c));
  return rest.length ? qs({ q: serializeQuery(rest), page: undefined }) : searchHref(lang, '');
};
// Catalogue filters → removable tags.
const catTags: { label: string; href: string }[] = [];
const listLabel: Record<string, (v: string) => string> = {
  fmt: (v) => formatGroupLabel(v, lang),
  loc: (v) => (v === 'partner' ? collectionLabel('partner', lang) : locationLabel(v, lang)),
  cl: (v) => languageLabel(v, lang),
  col: (v) => collectionLabel(v, lang),
};
for (const [param, key] of Object.entries(LIST_PARAMS)) {
  const vals = (cat as any)[key] as string[] | undefined;
  for (const v of vals ?? []) catTags.push({ label: `${t(lang, `adv.f.${key}` as any)}: ${listLabel[param](v)}`, href: qs({ [param]: vals!.filter((x) => x !== v), page: undefined }) });
}
for (const [param, key] of Object.entries(FLAG_PARAMS)) if ((cat as any)[key]) catTags.push({ label: t(lang, `adv.flag.${param}` as any), href: qs({ [param]: undefined, page: undefined }) });
const advHref = (() => {
  const u = new URL(qs({}), 'http://x');
  return `${searchHref(lang, '').split('?')[0]}/advanced${u.search}`;
})();
const tips = (['phrase', 'field', 'or', 'not', 'year', 'isbn'] as const).map((k) => ({ label: t(lang, `q.tip.${k}` as any), ex: t(lang, `q.tip.ex.${k}` as any) }));
const tagLabel = (k: string) => (engineData.tags[k]?.[lang] ?? k);
const meta = (r: (typeof engineData.records)[number]) => {
  if (r.type === 'event' && r.start) {
    const d = new Date(r.start);
    return `${formatDate(lang, d, { weekday: 'long', day: 'numeric', month: 'long' })} · ${formatDate(lang, d, { hour: '2-digit', minute: '2-digit', hour12: false })} · ${r.place?.[lang] ?? ''} · ${t(lang, r.booking === 'register' ? 'meta.register' : 'meta.dropin')}`;
  }
  if (r.catalogue) return [formatLabel(r.catalogue.format, lang), r.year ?? r.catalogue.publication?.year, r.catalogue.language !== 'zxx' && languageLabel(r.catalogue.language, lang)].filter(Boolean).join(' · ');
  if (r.type === 'book') return [r.year, t(lang, `meta.lang.${r.lang}` as any)].filter(Boolean).join(' · ');
  if (r.type === 'database') return t(lang, r.access === 'onsite' ? 'meta.onsite' : 'meta.remote');
  return '';
};
const plural = new Intl.PluralRules(lang).select(total);
const countLabel = total === 0 ? t(lang, 'search.count0') : total === 1 ? t(lang, 'search.count1') : plural === 'two' ? t(lang, 'search.count2') : plural === 'few' ? fmt(t(lang, 'search.countFew'), { n: total }) : fmt(t(lang, 'search.count'), { n: total });
const title = q ? fmt(t(lang, 'results.for'), { q }) : t(lang, 'results.title');
---
<Header lang={lang} tone="light" />
<main id="main" class="results" tabindex="-1">
  <div class="wrap top">
    <SearchBar lang={lang} variant="page" initialQuery={q} initialGroup={group} />
  </div>

  <div class="wrap layout">
    <aside class="facets" aria-labelledby="facets-h">
      <h2 id="facets-h" class="sr-only">{t(lang, 'search.filters')}</h2>
      <form method="get" action={searchHref(lang, '').split('?')[0]} class="facet-form" data-autosubmit>
        <input type="hidden" name="q" value={q} />
        <fieldset>
          <legend>{t(lang, 'results.type')}</legend>
          {(['all', ...GROUP_ORDER] as const).map((g) => (
            <label class="opt-line">
              <input type="radio" name="type" value={g === 'all' ? '' : g} checked={group === g} />
              <span>{g === 'all' ? t(lang, 'filter.all') : t(lang, `group.${g}` as any)}</span>
              {res && <span class="n">{g === 'all' ? Object.values(res.facets.group).reduce((a, b) => a + b, 0) : res.facets.group[g] ?? 0}</span>}
            </label>
          ))}
        </fieldset>
        <fieldset>
          <legend>{t(lang, 'results.audience')}</legend>
          {AUD.map((a) => (
            <label class="opt-line">
              <input type="checkbox" name="aud" value={a} checked={audience.includes(a)} />
              <span>{t(lang, `aud.${a}` as any)}</span>
              {res && <span class="n">{res.facets.audience[a] ?? 0}</span>}
            </label>
          ))}
        </fieldset>
        <fieldset>
          <legend>{t(lang, 'results.language')}</legend>
          {(['ar', 'en'] as const).map((l) => (
            <label class="opt-line">
              <input type="checkbox" name="lang" value={l} checked={language.includes(l)} />
              <span>{t(lang, `meta.lang.${l}` as any)}</span>
              {res && <span class="n">{res.facets.language[l] ?? 0}</span>}
            </label>
          ))}
        </fieldset>
        <fieldset>
          <legend>{t(lang, 'results.date')}</legend>
          <label class="opt-line"><input type="radio" name="date" value="" checked={!date} /><span>{t(lang, 'filter.all')}</span></label>
          {(['week', 'month', 'later'] as const).map((d) => (
            <label class="opt-line">
              <input type="radio" name="date" value={d} checked={date === d} />
              <span>{t(lang, `results.date.${d}` as any)}</span>
              {res && <span class="n">{res.facets.date[d] ?? 0}</span>}
            </label>
          ))}
        </fieldset>
        <input type="hidden" name="sort" value={sort === 'relevance' ? '' : sort} />
        {Object.entries(LIST_PARAMS).flatMap(([param, key]) => ((cat as any)[key] ?? []).map((v: string) => <input type="hidden" name={param} value={v} />))}
        {Object.entries(FLAG_PARAMS).map(([param, key]) => (cat as any)[key] && <input type="hidden" name={param} value="1" />)}
        <div class="facet-actions">
          <button class="btn btn--secondary" type="submit">{t(lang, 'results.apply')}</button>
          {(audience.length || language.length || date || group !== 'all' || catTags.length > 0) && <a class="link" href={qs({ type: undefined, aud: [], lang: [], date: undefined, fmt: [], loc: [], cl: [], col: [], avail: undefined, online: undefined, atqnl: undefined })}>{t(lang, 'results.reset')}</a>}
        </div>
      </form>
    </aside>

    <section class="list" aria-labelledby="results-h">
      <div class="list-head">
        <div>
          <h1 id="results-h" class="t-h2">{q || browsing ? (clauses.length || catTags.length ? t(lang, 'results.title') : title) : t(lang, 'results.empty')}</h1>
          {(clauses.length > 0 || catTags.length > 0) && (
            <ul class="qtags" aria-label={t(lang, 'q.yourQuery')}>
              {clauses.map((c, i) => (
                <li class={`qtag${c.op === 'NOT' ? ' qtag--not' : ''}`}>
                  <span>{clauseText(c)}</span>
                  <a href={without(i)} aria-label={fmt(t(lang, 'q.remove'), { c: clauseText(c) })}>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 6l8 8M14 6l-8 8" /></svg>
                  </a>
                </li>
              ))}
              {catTags.map((tg) => (
                <li class="qtag qtag--filter">
                  <span>{tg.label}</span>
                  <a href={tg.href} aria-label={fmt(t(lang, 'q.remove'), { c: tg.label })}>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 6l8 8M14 6l-8 8" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          )}
          {(q || browsing) && <p class="count" aria-live="polite"><span>{countLabel}</span>{total > PER && <span class="t-mono"> · {fmt(t(lang, 'results.showing'), { n: hits.length, total })}</span>}</p>}
        </div>
        {(q || browsing) && (
          <form method="get" class="sort" data-autosubmit>
            <input type="hidden" name="q" value={q} />
            {group !== 'all' && <input type="hidden" name="type" value={group} />}
            {audience.map((a) => <input type="hidden" name="aud" value={a} />)}
            {language.map((l) => <input type="hidden" name="lang" value={l} />)}
            {date && <input type="hidden" name="date" value={date} />}
            {Object.entries(LIST_PARAMS).flatMap(([param, key]) => ((cat as any)[key] ?? []).map((v: string) => <input type="hidden" name={param} value={v} />))}
            {Object.entries(FLAG_PARAMS).map(([param, key]) => (cat as any)[key] && <input type="hidden" name={param} value="1" />)}
            <label for="sort-sel">{t(lang, 'results.sort')}</label>
            <select id="sort-sel" name="sort">
              {(['relevance', 'date', 'title'] as const).map((k) => <option value={k} selected={sort === k}>{t(lang, `results.sort.${k}` as any)}</option>)}
            </select>
            <noscript><button class="btn btn--ghost" type="submit">{t(lang, 'results.apply')}</button></noscript>
            <button type="button" class="share link" data-share data-copied={t(lang, 'results.copied')} hidden>{t(lang, 'results.share')}</button>
          </form>
        )}
      </div>

      <p class="adv-link"><a class="link" href={advHref}>{q || browsing ? t(lang, 'adv.edit') : t(lang, 'adv.title')}</a></p>
      <details class="tips">
        <summary>{t(lang, 'q.tips')}</summary>
        <dl>
          {tips.map((tp) => (<><dt>{tp.label}</dt><dd><a class="link" href={searchHref(lang, tp.ex)}><bdi>{tp.ex}</bdi></a></dd></>))}
        </dl>
        <p class="tips-fields">{t(lang, 'q.tip.fields')}</p>
      </details>

      {res?.task && page === 1 && (
        <article class="answer" aria-labelledby="answer-h">
          <p class="t-eyebrow">{t(lang, 'search.answer')} <span class="sample-tag">{t(lang, 'label.sample')}</span></p>
          <h2 id="answer-h" class="answer-title">{res.task.record.title[lang]}</h2>
          <p class="answer-body">{res.task.record.task!.answer[lang]}</p>
          <a class="btn btn--primary" href={itemHref(lang, res.task.record)} data-result={res.task.record.id} data-type={res.task.record.type} data-pos="0">{res.task.record.task!.action[lang]} <span class="arrow icon-dir" aria-hidden="true">→</span></a>
        </article>
      )}

      {(q || browsing) && total > 0 && (
        <ol class="hits" start={(page - 1) * PER + 1}>
          {hits.filter((h) => !(res?.task && page === 1 && h.record.id === res.task.record.id)).map((h, i) => (
            <li class="hit">
              <p class="hit-type">{t(lang, `group.${TYPE_TO_GROUP[h.record.type]}` as any)}{h.record.type === 'heritage' || h.record.type === 'event' || h.record.type === 'book' || h.record.type === 'database' ? <span class="sample-tag">{t(lang, 'label.sample')}</span> : null}</p>
              <h2 class="hit-h"><a href={itemHref(lang, h.record)} data-result={h.record.id} data-type={h.record.type} data-pos={(page - 1) * PER + i + 1}>{Hl(h.record.title[lang], h.terms).map((s) => s.m ? <mark>{s.t}</mark> : s.t)}</a></h2>
              <p class="hit-sum">{Hl(h.record.summary[lang], h.terms).map((s) => s.m ? <mark>{s.t}</mark> : s.t)}</p>
              {meta(h.record) && <p class="hit-meta">{meta(h.record)}</p>}
              <ul class="hit-tags" aria-label={t(lang, 'item.related')}>
                {h.record.tags.slice(0, 3).filter((k) => engineData.tags[k]).map((k) => <li><a class="tag tag--quiet" href={searchHref(lang, tagLabel(k))}>{tagLabel(k)}</a></li>)}
              </ul>
            </li>
          ))}
        </ol>
      )}

      {(q || browsing) && total === 0 && (
        <div class="zero-page">
          <h2 class="t-h3">{fmt(t(lang, 'search.zero.title'), { q: q || catTags.map((x) => x.label).join(lang === 'ar' ? '، ' : ', ') })}</h2>
          <p>{t(lang, 'search.zero.body')}</p>
          <div class="zero-grid">
            <a class="task" href={itemHref(lang, { id: 'sv-ask' })}>
              <span class="task__label">{t(lang, 'search.zero.librarian')}</span>
              <span class="task__go"><span class="task__help">{t(lang, 'search.zero.librarianHelp')}</span><span class="arrow icon-dir" aria-hidden="true">→</span></span>
            </a>
            <a class="task" href={catalogueHref(q)} rel="noopener">
              <span class="task__label">{t(lang, 'search.zero.catalogue')}</span>
              <span class="task__go"><span class="task__help">{t(lang, 'search.zero.catalogueHelp')}</span><span class="arrow icon-dir" aria-hidden="true">→</span></span>
            </a>
          </div>
          <h3 class="t-ui related-h">{t(lang, 'search.zero.related')}</h3>
          <ul class="hit-tags">
            {res!.related.map((k) => <li><a class="chip" href={searchHref(lang, tagLabel(k))}>{tagLabel(k)}</a></li>)}
          </ul>
        </div>
      )}

      {!q && !browsing && (
        <div class="zero-page">
          <ul class="hit-tags">
            {[1, 2, 3, 4, 5].map((i) => <li><a class="chip" href={searchHref(lang, t(lang, `popular.${i}` as any))}>{t(lang, `popular.${i}` as any)}</a></li>)}
          </ul>
        </div>
      )}

      {pages > 1 && (
        <nav class="pager" aria-label={t(lang, 'results.title')}>
          {page > 1 && <a class="btn btn--ghost" href={qs({ page: String(page - 1) })}><span class="arrow icon-dir" aria-hidden="true">←</span> {t(lang, 'results.prev')}</a>}
          <span class="t-mono">{fmt(t(lang, 'results.page'), { p: page })} / {pages}</span>
          {page < pages && <a class="btn btn--ghost" href={qs({ page: String(page + 1) })}>{t(lang, 'results.next')} <span class="arrow icon-dir" aria-hidden="true">→</span></a>}
        </nav>
      )}
    </section>
  </div>
</main>
<Footer lang={lang} />

<script define:vars={{ q, lang, total, group }}>
  // Progressive enhancement: auto-apply filters, copy link, analytics.
  document.querySelectorAll('form[data-autosubmit]').forEach((f) => {
    f.addEventListener('change', () => f.requestSubmit ? f.requestSubmit() : f.submit());
  });
  const share = document.querySelector('[data-share]');
  if (share && navigator.clipboard) {
    share.hidden = false;
    share.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const txt = share.textContent; share.textContent = share.dataset.copied;
      setTimeout(() => (share.textContent = txt), 1800);
    });
  }
  window.dataLayer = window.dataLayer || [];
  if (q) {
    window.dataLayer.push({ event: 'search_query', search_term: q, search_mode: 'library', search_filter: group, results_count: total, lang, source: 'results_page', ts: Date.now() });
    if (total === 0) window.dataLayer.push({ event: 'search_zero_results', search_term: q, search_filter: group, lang, ts: Date.now() });
  }
  document.querySelectorAll('[data-result]').forEach((a) => a.addEventListener('click', () => {
    window.dataLayer.push({ event: 'result_click', search_term: q, result_id: a.dataset.result, result_type: a.dataset.type, result_position: Number(a.dataset.pos), group, lang, source: 'results_page', ts: Date.now() });
  }));
</script>

<style>
  .results { padding-block-end: var(--s-12); }
  .top { padding-block: var(--s-4) var(--s-3); border-block-end: var(--hairline); }
  .top :global(.sb) { max-inline-size: 64rem; }
  .layout { display: grid; grid-template-columns: 15rem 1fr; gap: var(--s-6); padding-block-start: var(--s-5); }
  @media (max-width: 56rem) { .layout { grid-template-columns: 1fr; gap: var(--s-3); } .facets { order: 2; } }

  .facet-form { display: grid; gap: var(--s-3); position: sticky; inset-block-start: var(--s-2); }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 0.1rem; }
  legend { font-weight: 700; font-size: var(--fs-xs); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--color-grey-600); margin-block-end: 0.5rem; }
  :global([lang='ar']) legend { font-weight: 500; font-size: var(--fs-sm); }
  .opt-line { display: flex; align-items: center; gap: 0.6rem; min-block-size: 2.5rem; font-size: var(--fs-sm); cursor: pointer; }
  .opt-line input { inline-size: 1.125rem; block-size: 1.125rem; accent-color: var(--color-accent); margin: 0; }
  .opt-line .n { margin-inline-start: auto; font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--color-grey-600); }
  .facet-actions { display: grid; gap: var(--s-1); justify-items: start; }
  :global(.js) .facet-actions .btn { display: none; }

  .list-head { display: flex; justify-content: space-between; align-items: end; gap: var(--s-3); flex-wrap: wrap; padding-block-end: var(--s-3); border-block-end: var(--hairline); }
  .list-head h1 { margin: 0; overflow-wrap: anywhere; }
  .count { margin: 0.5rem 0 0; color: var(--color-grey-600); font-size: var(--fs-sm); }
  .qtags { list-style: none; margin: var(--s-2) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .qtag { display: inline-flex; align-items: center; gap: 0.25rem; padding-inline: 0.75rem 0.25rem; min-block-size: 2.25rem; border: 1px solid var(--color-grey-300); border-radius: var(--radius-2); background: var(--color-paper-2); font-size: var(--fs-sm); }
  .qtag--not span { text-decoration: line-through; text-decoration-color: var(--color-grey-600); }
  .qtag a { display: grid; place-items: center; inline-size: 2rem; block-size: 2rem; border-radius: var(--radius-1); color: var(--color-grey-800); }
  .qtag a:hover { background: var(--color-grey-100); color: var(--color-ink); }
  .qtag svg { inline-size: 0.9rem; block-size: 0.9rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }
  .adv-link { float: inline-end; margin: var(--s-2) 0 0; font-size: var(--fs-sm); min-block-size: 2.75rem; display: flex; align-items: center; }
  .qtag--filter { background: var(--color-paper); }
  .tips { margin-block: var(--s-2) 0; font-size: var(--fs-sm); }
  .tips summary { cursor: pointer; color: var(--color-grey-800); inline-size: fit-content; min-block-size: 2.75rem; display: flex; align-items: center; }
  .tips summary:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 0.25em; }
  .tips dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem var(--s-3); margin: var(--s-1) 0 0; padding: var(--s-2) var(--s-3); background: var(--color-paper-2); border-radius: var(--radius-2); }
  .tips dt { color: var(--color-grey-600); }
  .tips dd { margin: 0; font-family: var(--font-mono); font-size: 0.92em; }
  :global([lang='ar']) .tips dd { font-family: var(--font-arabic); font-size: 1em; }
  .tips-fields { margin: var(--s-1) 0 0; color: var(--color-grey-600); }
  @media (max-width: 40rem) { .tips dl { grid-template-columns: 1fr; gap: 0.15rem; } .tips dd { margin-block-end: 0.5rem; } }
