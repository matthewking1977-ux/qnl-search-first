---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FooterMini from '../components/FooterMini.astro';
import ForYou from '../components/ForYou.astro';
import TopTasks from '../components/TopTasks.astro';
import { heroPreload } from '../lib/preload';
---
<Base lang="en" preloadImage={heroPreload()}>
  <main id="main" tabindex="-1">
    <Hero lang="en" />
    <ForYou lang="en" />
    <TopTasks lang="en" />
  </main>
  <FooterMini lang="en" />
</Base>
