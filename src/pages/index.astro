---
import Base from '../layouts/Base.astro';
import SearchBand from '../components/SearchBand.astro';
import FooterMini from '../components/FooterMini.astro';
---
<Base lang="en">
  <main id="main" tabindex="-1">
    <SearchBand lang="en" />
    <section class="wrap" style="padding-block:4rem">
      <p class="t-eyebrow">Phase 2 · search core</p>
      <p class="t-lead prose-measure">Try “libary”, “opening times”, “renew”, “parking”, “اللؤلو”, or press <kbd>/</kbd> from anywhere. Full results at <a class="link" href="/search?q=pearl">/search</a>. Add <a class="link" href="/?perf=1">?perf=1</a> for timings.</p>
    </section>
  </main>
  <FooterMini lang="en" />
</Base>
