---
import Base from '../../layouts/Base.astro';
import SearchBand from '../../components/SearchBand.astro';
import FooterMini from '../../components/FooterMini.astro';
---
<Base lang="ar">
  <main id="main" tabindex="-1">
    <SearchBand lang="ar" />
    <section class="wrap" style="padding-block:4rem">
      <p class="t-eyebrow">المرحلة الثانية · محرك البحث</p>
      <p class="t-lead prose-measure">جرّب «مواعيد العمل» أو «تجديد» أو «مواقف» أو «اللؤلو»، أو اضغط <kbd>/</kbd> من أي مكان في الصفحة.</p>
    </section>
  </main>
  <FooterMini lang="ar" />
</Base>
