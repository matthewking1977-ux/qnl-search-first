---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import ForYou from '../../components/ForYou.astro';
import TopTasks from '../../components/TopTasks.astro';
import WhatsOn from '../../components/WhatsOn.astro';
import Collections from '../../components/Collections.astro';
import HeritageBand from '../../components/HeritageBand.astro';
import ResearchBand from '../../components/ResearchBand.astro';
import Newsletter from '../../components/Newsletter.astro';
import { heroPreload } from '../../lib/preload';
---
<Base lang="ar" preloadImage={heroPreload()}>
  <main id="main" tabindex="-1">
    <Hero lang="ar" />
    <ForYou lang="ar" />
    <TopTasks lang="ar" />
    <WhatsOn lang="ar" />
    <Collections lang="ar" />
    <HeritageBand lang="ar" />
    <ResearchBand lang="ar" />
    <Newsletter lang="ar" />
  </main>
  <Footer lang="ar" />
</Base>
